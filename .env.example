# Server-side only (never exposed to the browser). Set these in Vercel → Project → Settings → Environment Variables,
# or pull them locally with `vercel env pull .env` for `vercel dev`.

# ── Cloud vault (encrypted cross-device quiz sync) ─────────────────
# Added automatically when you connect Upstash Redis from the Vercel Marketplace (Storage tab).
# The vault only stores ciphertext; the passphrase never leaves the browser.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Optional: requests per IP per minute against /api/vault (default 60)
# VAULT_RATE_LIMIT=60
