# Server-side only (never exposed to the browser). Set these in Vercel → Project → Settings → Environment Variables,
# or in a local .env file for `npm run dev`.

# Required for the AI Quiz generator
ANTHROPIC_API_KEY=

# Optional: override the Claude model used for generation
# ANTHROPIC_MODEL=claude-sonnet-5

# Optional: until Google login is added, require this code (entered in Settings) to use the AI generator
# AI_ACCESS_CODE=
